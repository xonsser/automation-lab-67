# Временные файлы текстовых редакторов (например, Emacs)
*~

# Файлы с расширением `.swp` и `.swo` (некоторые редакторы)
*.swp
*.swo

# Временные файлы с расширением `.tmp`
*.tmp

# Директории с названиями `tmp`, `temp` или `cache` на любом уровне вложенности
tmp/
temp/
cache/

# Директория `.idea` — это папка проекта, а не временная
.idea/

# Директория `node_modules` — это зависимость проекта, а не временный файл
node_modules/
